local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local playerGui = player:WaitForChild("PlayerGui")

-- SETTINGS
local aimAssistEnabled = true
local aimAssistStrength = 0.10
local maxDistance = 150
local aimRadius = 180

local currentHighlight = nil
local currentTarget = nil

-- MOBILE BUTTON UI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AimAssistUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 140, 0, 50)
toggleButton.Position = UDim2.new(0.75, 0, 0.8, 0)
toggleButton.Text = "Aim Assist: ON"
toggleButton.Parent = screenGui

toggleButton.MouseButton1Click:Connect(function()
	aimAssistEnabled = not aimAssistEnabled

	toggleButton.Text =
		aimAssistEnabled and "Aim Assist: ON"
		or "Aim Assist: OFF"

	-- Remove target highlight when off
	if not aimAssistEnabled then
		if currentHighlight then
			currentHighlight:Destroy()
			currentHighlight = nil
		end
		currentTarget = nil
	end
end)

-- TEAM CHECK
local function isEnemy(targetPlayer)
	if targetPlayer == player then
		return false
	end

	if player.Team and targetPlayer.Team then
		if player.Team == targetPlayer.Team then
			return false
		end
	end

	return true
end

-- TARGET HIGHLIGHT
local function setTargetHighlight(character)
	if currentHighlight then
		currentHighlight:Destroy()
	end

	currentHighlight = nil

	if character then
		local highlight = Instance.new("Highlight")
		highlight.Name = "AimLock"
		highlight.FillTransparency = 0.65
		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = character

		currentHighlight = highlight
	end
end

-- FIND TARGET
local function getClosestTarget()
	local closestTarget = nil
	local closestDistance = math.huge

	for _, target in ipairs(Players:GetPlayers()) do
		if isEnemy(target) and target.Character then
			local head = target.Character:FindFirstChild("Head")
			local humanoid = target.Character:FindFirstChild("Humanoid")

			if head and humanoid and humanoid.Health > 0 then
				local screenPos, visible =
					camera:WorldToViewportPoint(head.Position)

				if visible then
					local center = Vector2.new(
						camera.ViewportSize.X / 2,
						camera.ViewportSize.Y / 2
					)

					local distance =
						(Vector2.new(screenPos.X, screenPos.Y)
						- center).Magnitude

					local worldDistance =
						(head.Position - camera.CFrame.Position).Magnitude

					if distance < aimRadius
						and worldDistance < maxDistance
						and distance < closestDistance then

						closestDistance = distance
						closestTarget = head
					end
				end
			end
		end
	end

	return closestTarget
end

-- AIM ASSIST LOOP
RunService.RenderStepped:Connect(function()
	if not aimAssistEnabled then return end

	local target = getClosestTarget()

	if target ~= currentTarget then
		currentTarget = target

		if target and target.Parent then
			setTargetHighlight(target.Parent)
		else
			setTargetHighlight(nil)
		end
	end

	if target then
		local currentCFrame = camera.CFrame
		local targetCFrame = CFrame.lookAt(
			currentCFrame.Position,
			target.Position
		)

		camera.CFrame = currentCFrame:Lerp(
			targetCFrame,
			aimAssistStrength
		)
	end
end)
